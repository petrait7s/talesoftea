---
// Porcelain cup with tea, shaded to feel 3D. Steam is drawn on a canvas in the hero.
const { size = 300, steam = false } = Astro.props;
---
<svg width={size} height={size * 0.84} viewBox="0 0 240 200" fill="none" aria-hidden="true" style="overflow:visible">
  <defs>
    <linearGradient id="cb" x1="0" x2="1"><stop offset="0" stop-color="#e9d6b3" /><stop offset=".3" stop-color="#fff9ec" /><stop offset=".75" stop-color="#f3e4c6" /><stop offset="1" stop-color="#cdb48a" /></linearGradient>
    <linearGradient id="sc" x1="0" x2="1"><stop offset="0" stop-color="#d9c29b" /><stop offset=".5" stop-color="#fff6e2" /><stop offset="1" stop-color="#cdb48a" /></linearGradient>
    <radialGradient id="tea" cx="45%" cy="40%" r="70%"><stop offset="0" stop-color="#e8903a" /><stop offset=".6" stop-color="#b8601f" /><stop offset="1" stop-color="#7a3e14" /></radialGradient>
    <filter id="blur6"><feGaussianBlur stdDeviation="6" /></filter>
  </defs>
  <ellipse cx="120" cy="178" rx="104" ry="14" fill="#000" opacity=".28" filter="url(#blur6)" />
  <ellipse cx="120" cy="166" rx="102" ry="19" fill="url(#sc)" />
  <ellipse cx="120" cy="163" rx="70" ry="11" fill="#e7d3ac" />
  <path d="M188 92 C226 88 226 142 180 142" stroke="#cdb48a" stroke-width="11" stroke-linecap="round" />
  <path d="M188 92 C222 90 222 138 181 140" stroke="#fff3da" stroke-width="5" stroke-linecap="round" opacity=".85" />
  <path d="M48 80 H192 C192 134 162 166 120 166 C78 166 48 134 48 80Z" fill="url(#cb)" />
  <path d="M60 92 C62 124 76 148 98 158" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity=".55" />
  <ellipse cx="120" cy="80" rx="72" ry="17" fill="#fff9ec" />
  <ellipse cx="120" cy="82" rx="63" ry="12.5" fill="url(#tea)" />
  <ellipse cx="102" cy="79" rx="26" ry="4" fill="#fff" opacity=".22" />
  <ellipse cx="120" cy="80" rx="72" ry="17" stroke="#e5d2ac" stroke-width="1.5" />
  {steam && <g stroke="#F6E8C8" stroke-width="5" stroke-linecap="round" fill="none"><path class="st" d="M92 60c-8 10 8 14 0 28" /><path class="st" d="M120 54c-8 10 8 14 0 28" /><path class="st" d="M148 60c-8 10 8 14 0 28" /></g>}
</svg>
