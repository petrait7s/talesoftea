---
// Illustrated tea-garden scene: stand-in until a real photo (public/hero.jpg) is added.
const { variant = 0 } = Astro.props;
const W = 1600, H = 900;
const V = [
  { sky: ['#f9e6b4', '#cfe5bd', '#9fc9a0'], sun: ['#fff6d6', '#ffe6a3'], pos: ['72%', '22%'], rays: 0.42, h1: '#86b28a', h2: '#5f9a6a', tint: [1, 1, 1] },
  { sky: ['#cbe8f4', '#e2f1dc', '#b3d7ae'], sun: ['#ffffff', '#eaf6ff'], pos: ['28%', '16%'], rays: 0.2, h1: '#7fb0a0', h2: '#4f9670', tint: [0.9, 1.04, 1.1] },
  { sky: ['#f5b567', '#f3d29a', '#c7d8a0'], sun: ['#fff0c0', '#ffb865'], pos: ['80%', '34%'], rays: 0.5, h1: '#a9a779', h2: '#7a9a5a', tint: [1.35, 1.0, 0.7] },
][variant % 3];
const rows = Array.from({ length: 12 }, (_, i) => {
  const t = i / 11;
  const y = 440 + t * t * 400 + t * 50;
  const r = 13 + t * 52;
  const step = r * 1.75;
  const n = Math.ceil((W + 200) / step) + 1;
  let d = `M-100 ${y + r}`;
  for (let k = 0; k < n; k++) d += ` a${r} ${r * 0.95} 0 0 1 ${step} 0`;
  const top = d;
  d += ` V${H} H-100 Z`;
  const shade = Math.round(120 - t * 70), g = Math.round(168 - t * 92), b = Math.round(96 - t * 50);
  const c = (v: number, k: number) => Math.max(0, Math.min(255, Math.round(v * k)));
  return { d, top, fill: `rgb(${c(shade * 0.55, V.tint[0])} ${c(g, V.tint[1])} ${c(b, V.tint[2])})`, o: 0.55 + t * 0.45, r };
});
---
<svg class="hero-bg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`sky${variant}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={V.sky[0]} /><stop offset=".55" stop-color={V.sky[1]} /><stop offset="1" stop-color={V.sky[2]} /></linearGradient>
    <radialGradient id={`sun${variant}`} cx={V.pos[0]} cy={V.pos[1]} r="42%"><stop offset="0" stop-color={V.sun[0]} stop-opacity=".95" /><stop offset=".4" stop-color={V.sun[1]} stop-opacity=".45" /><stop offset="1" stop-color={V.sun[1]} stop-opacity="0" /></radialGradient>
    <linearGradient id={`mist${variant}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9f3dc" stop-opacity="0" /><stop offset="1" stop-color="#e9f3dc" stop-opacity=".7" /></linearGradient>
    <linearGradient id={`ray${variant}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3c4" stop-opacity={V.rays} /><stop offset="1" stop-color="#fff3c4" stop-opacity="0" /></linearGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#sky${variant})`} />
  <rect width={W} height={H} fill={`url(#sun${variant})`} />
  <path d="M0 470 C180 380 330 440 520 390 C720 340 860 430 1060 380 C1260 330 1420 420 1600 360 V900 H0Z" fill={V.h1} opacity=".55" />
  <path d="M0 500 C220 430 380 480 600 440 C820 400 980 490 1200 440 C1380 400 1500 470 1600 430 V900 H0Z" fill={V.h2} opacity=".7" />
  <rect y="380" width={W} height="220" fill={`url(#mist${variant})`} />
  <g>
    <polygon points="1030,0 1180,0 880,700 560,700" fill={`url(#ray${variant})`} />
    <polygon points="1250,0 1330,0 1180,700 1000,700" fill={`url(#ray${variant})`} opacity=".7" />
    <polygon points="820,0 880,0 520,700 360,700" fill={`url(#ray${variant})`} opacity=".5" />
  </g>
  {rows.map((r) => (
    <g opacity={r.o.toFixed(2)}>
      <path d={r.d} fill={r.fill} />
      <path d={r.top} fill="none" stroke="#d9f0b0" stroke-opacity=".22" stroke-width={Math.max(1.5, r.r * 0.09)} />
    </g>
  ))}
  <rect y="560" width={W} height="340" fill={`url(#mist${variant})`} opacity=".28" />
</svg>
