---
// Stand-up pouch. Size scales with the chosen weight (set from the product page script).
const { t } = Astro.props;
---
<div class="pack" id="pack" style="--ps:.68" aria-hidden="true">
  <svg viewBox="0 0 120 160" width="100%" fill="none">
    <defs>
      <linearGradient id="pk" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={t.c[1]} /><stop offset="1" stop-color={t.c[0]} /></linearGradient>
      <linearGradient id="pkh" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".38" /><stop offset=".35" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".18" /></linearGradient>
    </defs>
    <ellipse cx="60" cy="154" rx="46" ry="5" fill="#000" opacity=".28" />
    <path d="M16 24 H104 L110 42 V138 Q110 150 98 150 H22 Q10 150 10 138 V42 Z" fill="url(#pk)" />
    <path d="M16 24 H104 L110 42 V138 Q110 150 98 150 H22 Q10 150 10 138 V42 Z" fill="url(#pkh)" />
    <path d="M16 24 L22 14 L28 24 L34 14 L40 24 L46 14 L52 24 L58 14 L64 24 L70 14 L76 24 L82 14 L88 24 L94 14 L100 24 L104 24 V28 H16 Z" fill={t.c[0]} opacity=".85" />
    <rect x="24" y="58" width="72" height="62" rx="9" fill="#fbf6e8" opacity=".96" />
    <path d="M60 66 c-9 7 -9 17 0 24 c9 -7 9 -17 0 -24z" fill={t.c[0]} opacity=".9" />
    <text x="60" y="102" text-anchor="middle" font-size="9" font-weight="700" fill="#1f2a1f" font-family="Montserrat, sans-serif" letter-spacing=".5">TALES OF TEA</text>
    <text id="packW" x="60" y="115" text-anchor="middle" font-size="11" font-weight="700" fill={t.c[0]} font-family="Montserrat, sans-serif">250g</text>
  </svg>
</div>
