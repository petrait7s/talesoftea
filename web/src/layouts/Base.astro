---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/tiro-bangla/bengali-400.css';
import '@fontsource/tiro-bangla/latin-400.css';
import '../styles/global.css';
import T from '../components/T.astro';
import { TEAS, WEIGHTS, DELIVERY } from '../data/teas';
const { title = 'Tales of Tea', active = 'home', band = true, cbar = true, description = 'Tea, ordered from home. Cash on delivery, bKash, Nagad.' } = Astro.props;
const data = { teas: TEAS, weights: WEIGHTS, delivery: DELIVERY, api: import.meta.env.PUBLIC_API_URL || '' };
---
<!doctype html>
<html lang="bn">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#2F6B3A" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <script is:inline>
    try { document.documentElement.lang = localStorage.getItem('tot_lang') || 'bn'; } catch (e) {}
  </script>
</head>
<body>
  <header class="top">
    <div class="bar glass">
      <a class="brand" href="/"><img src="/logo.png" alt="Tales of Tea" width="74" height="44" /></a>
      <nav class="nav">
        <a href="/" class={active === 'home' ? 'on' : ''}><T bn="হোম" en="Home" /></a>
        <a href="/shop/" class={active === 'shop' ? 'on' : ''}><T bn="শপ" en="Shop" /></a>
        <a href="/story/" class={active === 'story' ? 'on' : ''}><T bn="আমাদের গল্প" en="Our Story" /></a>
        <a href="/contact/" class={active === 'contact' ? 'on' : ''}><T bn="যোগাযোগ" en="Contact" /></a>
      </nav>
      <div class="tools">
        <button class="lang" id="langBtn" type="button" aria-label="Language"><span class="bn">EN</span><span class="en">বাংলা</span></button>
        <a class="cartbtn" href="/cart/"><T bn="কার্ট" en="Cart" /> <span class="badge" data-badge>0</span></a>
      </div>
    </div>
  </header>

  <main><slot /></main>

  {band && (
    <section class="goldband"><div class="wrap">
      <h2><T bn="চা বেছে নিতে তৈরি?" en="Ready to pick your tea?" /></h2>
      <p><T bn="অর্ডার দিন, আমরা ফোন করে কনফার্ম করব।" en="Place an order, we will call to confirm." /></p>
      <div class="btns"><a class="btn forest" href="/shop/"><T bn="চা কিনুন" en="Shop teas" /></a><a class="btn outline-d" href="#">Facebook</a></div>
    </div></section>
  )}

  <footer>
    <div class="wrap">
      <div><span class="logochip"><img src="/logo.png" alt="Tales of Tea" width="87" height="52" /></span><br /><T bn="প্রতি কাপে একটা গল্প।" en="A story in every cup." /></div>
      <div><b><T bn="শপ" en="Shop" /></b><a href="/shop/"><T bn="সব চা" en="All teas" /></a><a href="/cart/"><T bn="কার্ট" en="Cart" /></a></div>
      <div><b><T bn="কোম্পানি" en="Company" /></b><a href="/story/"><T bn="আমাদের গল্প" en="Our Story" /></a><a href="/contact/"><T bn="যোগাযোগ" en="Contact" /></a></div>
      <div><b><T bn="যোগাযোগ" en="Contact" /></b><span>01XXX-XXXXXX</span><a href="#">Facebook Page</a><span><T bn="সকাল 9টা - রাত 9টা" en="9am - 9pm" /></span></div>
    </div>
  </footer>

  <nav class="tabs glass" aria-label="Main">
    <a href="/" class={active === 'home' ? 'on' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8v10H3z"/></svg><span><T bn="হোম" en="Home" /></span></a>
    <a href="/shop/" class={active === 'shop' ? 'on' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 8h13v5a6 6 0 01-6 6H10a6 6 0 01-6-6V8zM17 10h2a2 2 0 010 4h-2M8 3v2M12 3v2"/></svg><span><T bn="শপ" en="Shop" /></span></a>
    <a href="/story/" class={active === 'story' ? 'on' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h10a4 4 0 014 4v12H9a4 4 0 01-4-4zM9 9h6M9 13h6"/></svg><span><T bn="গল্প" en="Story" /></span></a>
    <a href="/cart/" class={active === 'cart' ? 'on' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h3l2 11h10l2-8H7"/><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/></svg><span><T bn="কার্ট" en="Cart" /></span><span class="badge" data-badge>0</span></a>
  </nav>

  {cbar && (
    <a class="cbar glass" id="cbar" href="/cart/" hidden>
      <span><b id="cbN">0</b> <T bn="আইটেম" en="items" /> · <b id="cbT">0</b></span>
      <span class="go"><T bn="অর্ডার" en="Checkout" /></span>
    </a>
  )}
  <div class="offline" id="offline" hidden><T bn="ইন্টারনেট নেই। কার্ট ঠিক আছে, অর্ডার দিতে নেট লাগবে।" en="You are offline. Your cart is safe; you need internet to order." /></div>
  <div class="toast" id="toast" role="status"></div>
  <script type="application/json" id="tot-data" set:html={JSON.stringify(data)} />
  <script>
    import '../scripts/app';
  </script>
</body>
</html>
