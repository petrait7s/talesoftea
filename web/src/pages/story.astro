---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---
<Base title="আমাদের গল্প | Tales of Tea" active="story">
  <div class="wrap">
    <div class="sbanner"><div class="eyebrow" style="color:var(--amber)">Tales of Tea</div><h1><T bn="আমাদের গল্প" en="Our story" /></h1><p><T bn="প্রতি কাপ চায়ের পেছনে একটা গল্প থাকে। আমরা সেই গল্প আপনার কাছে পৌঁছে দিই।" en="Behind every cup of tea there is a story. We bring it to your door." /></p></div>
    <section class="sec">
      <div class="center"><h2><T bn="আমরা যা কথা দিই" en="What we promise" /></h2></div><br />
      <div class="cards3">
        <div class="feat glass"><span class="no">01</span><h3><T bn="ঠিক ওজন" en="Right weight" /></h3><p><T bn="যে ওজনের অর্ডার, সেই ওজনের চা।" en="The weight you order is the weight you get." /></p></div>
        <div class="feat glass"><span class="no">02</span><h3><T bn="পরিষ্কার দাম" en="Clear price" /></h3><p><T bn="কার্টেই মোট দাম দেখুন, লুকানো খরচ নেই।" en="See the full price in your cart. No hidden costs." /></p></div>
        <div class="feat glass"><span class="no">03</span><h3><T bn="দরজায় পেমেন্ট" en="Pay at the door" /></h3><p><T bn="চা হাতে পেয়ে টাকা দিন, অথবা বিকাশ/নগদে আগেই।" en="Pay when the tea arrives, or ahead by bKash/Nagad." /></p></div>
      </div>
    </section>
    <section class="sec"><div class="ph"><T bn="প্রতিষ্ঠাতার কথা ও ছবি এখানে বসবে।" en="Founder's note and photo will go here." /></div></section>
    <section class="sec center" style="padding-top:0"><a class="btn green" href="/shop/"><T bn="চা কিনুন" en="Shop teas" /></a></section>
  </div>
</Base>
