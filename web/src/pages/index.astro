---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import TeaCard from '../components/TeaCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import { TEAS, price } from '../data/teas';
const feat = TEAS.filter((t) => [1, 4, 3, 6].includes(t.id));
const first = TEAS[0];
// Photos: put files in web/public/hero/ (any names, sorted A-Z). Optional smaller copies named
// <name>-800.webp and <name>-1400.webp are used on phones. With no photos a plain gradient shows.
const pub = path.join(process.cwd(), 'public');
const ok = /\.(jpe?g|webp|png|avif)$/i;
const hasSize = /-(800|1400)\.\w+$/;
const photos = fs.existsSync(path.join(pub, 'hero'))
  ? fs.readdirSync(path.join(pub, 'hero')).filter((f) => ok.test(f) && !hasSize.test(f)).sort().map((f) => `/hero/${f}`)
  : [];
// Per-photo framing: intrinsic width (for srcset) and a focal point so the subject clears the headline.
const frame: Record<string, { w: number; st?: string }> = {
  'hero-1.webp': { w: 2000, st: 'object-position:50% 55%' },
  'hero-2.webp': { w: 2000, st: 'object-position:50% 40%' },
  'hero-3.webp': { w: 1588, st: 'object-position:50% 64%;--tx:15%;--sc:1.32;--ty:-16%;--msc:1.3' },
  'hero-4.webp': { w: 2000, st: 'object-position:50% 62%;--fx:-1' },
};
const srcset = (src: string, w: number) => {
  const base = src.replace(/\.\w+$/, ''), ext = src.slice(base.length);
  const has = (n: number) => fs.existsSync(path.join(pub, `${base}-${n}${ext}`));
  return [has(800) && `${base}-800${ext} 800w`, has(1400) && `${base}-1400${ext} 1400w`, `${src} ${w}w`].filter(Boolean).join(', ');
};
const slides = photos.map((src) => { const f = frame[src.split('/').pop() as string] || { w: 2000 }; return { src, st: f.st || '', set: srcset(src, f.w) }; });
---
<Base title="Tales of Tea | প্রতি কাপে একটা গল্প" active="home">
  <div class="zone"><div class="wrap">
    <section class="hero scene glass" id="hero">
      <div class="hero-bgwrap">
        {slides.length ? slides.map((sl, i) => (
          <div class={`slide ${i === 0 ? 'on' : ''}`}>
            <img class="hero-bg" src={sl.src} srcset={sl.set} sizes="100vw" alt="" style={sl.st} decoding="async" fetchpriority={i === 0 ? 'high' : 'auto'} loading="eager" />
          </div>
        )) : <div class="slide on"><div class="hero-fallback"></div></div>}
      </div>
      {slides.length > 1 && <div class="hero-dots">{slides.map((_, i) => <button type="button" class={i === 0 ? 'on' : ''} data-slide={i} aria-label={`Slide ${i + 1}`}></button>)}</div>}
      <div class="hero-shade"></div>
      <div class="grain"></div>
      <div class="hero-txt">
        <a id="greet" class="greet" href="/shop/" hidden><i></i><span class="bn"></span><span class="en"></span></a>
        <div class="chips"><span class="chip"><T bn="ক্যাশ অন ডেলিভারি" en="Cash on Delivery" /></span><span class="chip">bKash</span><span class="chip">Nagad</span></div>
        <h1><T html bn="প্রতি কাপে <em>একটা গল্প</em>" en="A story <em>in every cup</em>" /></h1>
        <p><T bn="ঘরে বসে ৮ রকমের চা অর্ডার করুন। ১০০ গ্রাম থেকে ১ কেজি। পেমেন্ট দরজায়।" en="Order 8 kinds of tea from home. 100g to 1kg. Pay at your door." /></p>
        <div class="cta"><a class="btn amber" href="/shop/"><T bn="চা কিনুন" en="Shop teas" /></a><a class="btn white" href="/story/"><T bn="আমাদের গল্প" en="Our story" /></a></div>
      </div>
    </section>

    <div class="bento">
      <a class="tile solid glass" href="/product/1/" style="text-decoration:none"><h3><T bn={first.n.bn} en={first.n.en} /></h3><p>৳{price(first, 0)} / 100g</p></a>
      <div class="tile mist glass"><div class="big">8</div><p><T bn="রকমের চা" en="kinds of tea" /></p></div>
      <div class="tile glass"><div class="big">COD</div><p><T bn="দরজায় পেমেন্ট" en="Pay at your door" /></p></div>
      <div class="tile glass"><div class="big">4</div><p><T bn="প্যাক: ১০০g থেকে ১kg" en="packs: 100g to 1kg" /></p></div>
    </div>
  </div></div>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="আমাদের চা" en="Our teas" /></div><h2><T bn="পছন্দের চা বেছে নিন" en="Pick your tea" /></h2></div><br />
    <div class="grid">{feat.map((t) => <TeaCard t={t} />)}</div>
    <div class="center" style="margin-top:24px"><a class="btn line" href="/shop/"><T bn="সব চা দেখুন" en="View all teas" /></a></div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="সহজ কেনা" en="Simple buying" /></div><h2><T bn="চা কেনা হোক সহজ" en="Buying tea, made simple" /></h2></div><br />
    <div class="cards3">
      <div class="feat glass"><span class="no">01</span><h3><T bn="ওজনে কিনুন" en="Buy by weight" /></h3><p><T bn="১০০g, ২৫০g, ৫০০g বা ১kg। যার যেমন দরকার।" en="100g, 250g, 500g or 1kg. Whatever you need." /></p></div>
      <div class="feat glass"><span class="no">02</span><h3><T bn="নিজের মতো পেমেন্ট" en="Pay your way" /></h3><p><T bn="ক্যাশ অন ডেলিভারি, বিকাশ বা নগদ।" en="Cash on delivery, bKash or Nagad." /></p></div>
      <div class="feat glass"><span class="no">03</span><h3><T bn="ফোনে কনফার্ম" en="Confirmed by phone" /></h3><p><T bn="অর্ডার দিন, আমরা ফোন করে নিশ্চিত করি।" en="Place your order, we call to confirm." /></p></div>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="অর্ডার" en="Ordering" /></div><h2><T bn="কীভাবে অর্ডার করবেন" en="How to order" /></h2></div><br />
    <div class="steps">
      <div class="step glass"><span class="n">1</span><div><b><T bn="চা বাছুন" en="Pick your tea" /></b><div><T bn="ওজন আর পরিমাণ ঠিক করুন।" en="Choose weight and quantity." /></div></div></div>
      <div class="step glass"><span class="n">2</span><div><b><T bn="তথ্য দিন" en="Share your details" /></b><div><T bn="নাম, ফোন, ঠিকানা আর পেমেন্ট পদ্ধতি।" en="Name, phone, address and payment method." /></div></div></div>
      <div class="step glass"><span class="n">3</span><div><b><T bn="আমরা কনফার্ম করি" en="We confirm" /></b><div><T bn="ফোন করে নিশ্চিত করে পাঠিয়ে দিই।" en="We call to confirm, then ship." /></div></div></div>
    </div>
  </div></section>

</Base>
<script>
  import { data } from '../scripts/app';
  const h = new Date().getHours();
  const slots = [
    { a: 5, b: 11, g: ['সুপ্রভাত', 'Good morning'], id: 3 },
    { a: 11, b: 15, g: ['শুভ দুপুর', 'Good afternoon'], id: 6 },
    { a: 15, b: 18, g: ['বিকালের চা-র সময়', 'Tea time'], id: 4 },
    { a: 18, b: 22, g: ['শুভ সন্ধ্যা', 'Good evening'], id: 1 },
  ];
  const s = slots.find((x) => h >= x.a && h < x.b) || { g: ['শুভ রাত্রি', 'Good night'], id: 7 };
  const t = data.teas.find((x) => x.id === s.id);
  const el = document.getElementById('greet') as HTMLAnchorElement | null;
  if (el && t) {
    el.href = `/product/${t.id}/`;
    el.querySelector('.bn')!.textContent = `${s.g[0]} · ${t.n.bn} চেখে দেখুন`;
    el.querySelector('.en')!.textContent = `${s.g[1]} · try ${t.n.en}`;
    el.hidden = false;
  }
</script>
