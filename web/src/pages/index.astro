---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import TeaCard from '../components/TeaCard.astro';
import Cup from '../components/Cup.astro';
import { TEAS, REVIEWS } from '../data/teas';
const feat = TEAS.filter((t) => [1, 4, 3, 6].includes(t.id));
---
<Base title="Tales of Tea | প্রতি কাপে একটা গল্প" active="home">
  <div class="wrap">
    <div class="bento">
      <section class="tile hero glass">
        <div class="cup"><Cup size={260} /></div>
        <div>
          <div class="chips"><span class="chip"><T bn="ক্যাশ অন ডেলিভারি" en="Cash on Delivery" /></span><span class="chip">bKash</span><span class="chip">Nagad</span></div>
          <h1><T html bn="প্রতি কাপে <em>একটা গল্প</em>" en="A story <em>in every cup</em>" /></h1>
          <p><T bn="বাগান থেকে বেছে আনা ৮ রকমের চা। ১০০ গ্রাম থেকে ১ কেজি। ঘরে বসে অর্ডার, দরজায় পেমেন্ট।" en="8 hand-picked teas from the gardens. 100g to 1kg. Order from home, pay at your door." /></p>
        </div>
        <div class="cta"><a class="btn amber" href="/shop/"><T bn="চা কিনুন" en="Shop teas" /></a><a class="btn white" href="/story/"><T bn="আমাদের গল্প" en="Our story" /></a></div>
      </section>
      <a class="tile solid glass" href="/product/1/" style="text-decoration:none"><h3><T bn="সিলেট প্রিমিয়াম" en="Sylhet Premium" /></h3><p>৳380 / 100g</p></a>
      <div class="tile mist glass"><div class="big">8</div><p><T bn="রকমের চা" en="teas" /></p></div>
      <div class="tile amber glass wide"><h3><T bn="চা বানানোর টিপ" en="Brewing tip" /></h3><p><T bn="গ্রিন টি ৮০°C পানিতে ২ মিনিট ভিজান।" en="Steep green tea at 80°C for 2 minutes." /></p></div>
      <div class="tile glass"><div class="big">COD</div><p><T bn="দরজায় পেমেন্ট" en="Pay at your door" /></p></div>
      <div class="tile glass"><div class="big">4</div><p><T bn="ওজনের প্যাক" en="pack sizes" /></p></div>
    </div>
  </div>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="জনপ্রিয়" en="Popular" /></div><h2><T bn="সবার প্রিয় চা" en="Customer favourites" /></h2><p class="sub"><T bn="যেগুলো সবচেয়ে বেশি অর্ডার হয়।" en="The teas people order most." /></p></div>
    <div class="grid">{feat.map((t) => <TeaCard t={t} />)}</div>
    <div class="center" style="margin-top:24px"><a class="btn line" href="/shop/"><T bn="সব চা দেখুন" en="View all teas" /></a></div>
  </div></section>

  <section class="sec"><div class="wrap"><div class="storyblock">
    <div class="txt"><div class="eyebrow" style="color:var(--amber)"><T bn="আমাদের গল্প" en="Our story" /></div>
      <h2><T bn="এক কাপ চায়ের পেছনের গল্প" en="The story behind your cup" /></h2>
      <p><T bn="আমাদের শুরু একটাই প্রশ্ন দিয়ে: ভালো চা কেন সহজে পাওয়া যায় না? বাগান থেকে সরাসরি পাতা বেছে, নিজেরা ব্লেন্ড করে, তাজা প্যাক করে আপনার কাছে পৌঁছাই।" en="We started with one question: why is good tea so hard to find? We pick leaf from the gardens, blend it ourselves and pack it fresh for you." /></p>
      <a class="btn amber" href="/story/"><T bn="আরও পড়ুন" en="Read more" /></a></div>
    <div class="art"><Cup size={190} /></div>
  </div></div></section>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="কেন আমরা" en="Why us" /></div><h2><T bn="চা, যেমন হওয়া উচিত" en="Tea, the way it should be" /></h2></div><br />
    <div class="cards3">
      <div class="feat glass"><i>🌱</i><h3><T bn="বাগান থেকে সরাসরি" en="Straight from the garden" /></h3><p><T bn="মধ্যস্বত্বভোগী কম, তাই দাম ঠিক আর পাতা তাজা।" en="Fewer middlemen: fair price, fresher leaf." /></p></div>
      <div class="feat glass"><i>⚖️</i><h3><T bn="ওজনে কিনুন" en="Buy by weight" /></h3><p><T bn="১০০ গ্রাম থেকে ১ কেজি, যার যেমন দরকার।" en="100g to 1kg, whatever you need." /></p></div>
      <div class="feat glass"><i>⚡</i><h3><T bn="সহজ অর্ডার" en="Easy ordering" /></h3><p><T bn="৬০ সেকেন্ডে অর্ডার, ফোন করে কনফার্ম।" en="Order in 60 seconds, we call to confirm." /></p></div>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="অর্ডার" en="Ordering" /></div><h2><T bn="কীভাবে অর্ডার করবেন" en="How to order" /></h2></div><br />
    <div class="steps">
      <div class="step glass"><span class="n">1</span><div><b><T bn="চা বাছুন" en="Pick your tea" /></b><div><T bn="ওজন আর পরিমাণ ঠিক করুন।" en="Choose weight and quantity." /></div></div></div>
      <div class="step glass"><span class="n">2</span><div><b><T bn="তথ্য দিন" en="Share your details" /></b><div><T bn="নাম, ফোন, ঠিকানা আর পেমেন্ট পদ্ধতি।" en="Name, phone, address and payment method." /></div></div></div>
      <div class="step glass"><span class="n">3</span><div><b><T bn="আমরা কনফার্ম করি" en="We confirm" /></b><div><T bn="ফোন করে নিশ্চিত করে পাঠিয়ে দিই।" en="We call to confirm, then ship." /></div></div></div>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="center"><div class="eyebrow"><T bn="রিভিউ" en="Reviews" /></div><h2><T bn="ক্রেতারা কী বলছেন" en="What customers say" /></h2></div><br />
    <div class="cards3">{REVIEWS.map((r) => (
      <div class="quote glass"><div class="stars">★★★★★</div><p>“<T bn={r.t.bn} en={r.t.en} />”</p><b><T bn={r.n.bn} en={r.n.en} /></b> <small style="color:var(--muted)">· <T bn={r.c.bn} en={r.c.en} /></small></div>
    ))}</div>
    <p class="note center"><T bn="* নমুনা রিভিউ। আসল রিভিউ পরে যুক্ত হবে।" en="* Sample reviews. Real ones will be added later." /></p>
  </div></section>

  <section class="sec"><div class="wrap"><div class="band">
    <h2><T bn="ফেসবুকে আমাদের সাথে থাকুন" en="Follow us on Facebook" /></h2>
    <p style="margin:6px 0 16px"><T bn="নতুন চা, অফার আর গল্প সবার আগে পেতে।" en="New teas, offers and stories first." /></p>
    <a class="fbbtn" href="#">f &nbsp;Facebook</a>
  </div></div></section>
</Base>
